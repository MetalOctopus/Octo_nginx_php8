#!/bin/bash
set -euo pipefail

PUID="${PUID:-99}"; PGID="${PGID:-100}"; UMASK="${UMASK:-022}"
WEBROOT="${WEBROOT:-/var/www/html}"

# --- runtime user (Unraid: 99:100 = nobody:users) ----------------------------
if [ "$PUID" = 0 ] || [ "$PGID" = 0 ]; then echo "PUID/PGID 0 (root) is refused" >&2; exit 1; fi
GROUP="$(getent group "$PGID" | cut -d: -f1 || true)"
if [ -z "$GROUP" ]; then addgroup -g "$PGID" www; GROUP=www; fi
OLD="$(getent passwd "$PUID" | cut -d: -f1 || true)"
[ -n "$OLD" ] && [ "$OLD" != www ] && deluser "$OLD" >/dev/null 2>&1 || true
deluser www >/dev/null 2>&1 || true
adduser -D -H -u "$PUID" -G "$GROUP" -s /sbin/nologin www

# --- /config (persisted): ssl, nginx override, php ini ------------------------
mkdir -p /config/ssl /config/nginx /config/php "$WEBROOT" /run/nginx /var/lib/nginx/tmp
if [ ! -s /config/ssl/cert.pem ] || [ ! -s /config/ssl/key.pem ]; then
  echo "[octo] generating self-signed certificate in /config/ssl (replace with your own cert.pem/key.pem)"
  openssl req -x509 -nodes -newkey rsa:3072 -days 825 -subj "/CN=${HOSTNAME}" \
    -keyout /config/ssl/key.pem -out /config/ssl/cert.pem 2>/dev/null
fi
chmod 600 /config/ssl/key.pem
chown -R www:"$GROUP" /var/lib/nginx

# --- config rendering ----------------------------------------------------------
sed -i "s/@USER@/www/g; s/@GROUP@/$GROUP/g" /etc/nginx/nginx.conf /usr/local/etc/php-fpm.d/zz-octo.conf
echo "root ${WEBROOT};" > /etc/nginx/octo-root.conf
[ -f /config/nginx/default.conf ] && cp /config/nginx/default.conf /etc/nginx/conf.d/default.conf

cat > /usr/local/etc/php/conf.d/zz-octo-env.ini <<INI
memory_limit = ${PHP_MEMORY_LIMIT}
upload_max_filesize = ${PHP_UPLOAD_MAX_FILESIZE}
post_max_size = ${PHP_UPLOAD_MAX_FILESIZE}
date.timezone = ${TZ}
INI
[ -e "/usr/share/zoneinfo/${TZ}" ] && ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime && echo "$TZ" > /etc/timezone

# placeholder page only when the webroot is completely empty
if [ -z "$(ls -A "$WEBROOT")" ]; then
  cp /usr/share/octo/index.html "$WEBROOT/index.html"; chown www:"$GROUP" "$WEBROOT/index.html"
fi

nginx -t
umask "$UMASK"
exec /usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf
